# ───────── Contextly MCP — environment (all optional) ─────────
# Normal setup needs NONE of this. Storage is chosen by ~/.contextly/config.json,
# which `contextly-auth` writes for you. These env vars are only for power users
# and CI who'd rather not run the interactive auth flow.

# Which backend to use: file (default) | dropbox | gdrive
# CONTEXTLY_STORE=file

# Where the local file store keeps its Markdown (default: ~/.contextly)
# CONTEXTLY_DIR=/path/to/folder

# ── Dropbox (instead of `contextly-auth dropbox`) ──
# DROPBOX_APP_KEY=your-dropbox-app-key
# DROPBOX_REFRESH_TOKEN=your-refresh-token

# ── Google Drive (instead of `contextly-auth gdrive`) ──
# GOOGLE_CLIENT_ID=your-oauth-client-id
# GOOGLE_CLIENT_SECRET=your-oauth-client-secret
# GOOGLE_REFRESH_TOKEN=your-refresh-token

# Loopback port the one-time auth flow listens on (default 53682)
# CONTEXTLY_AUTH_PORT=53682
